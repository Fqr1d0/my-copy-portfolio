---
// FieldsGrid.astro
---

<section class="py-16">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-3xl font-bold mb-8 text-center bg-clip-text text-transparent bg-gradient-to-r from-primary to-indigo-400 dark:from-indigo-400 dark:to-primary">Industry Expertise</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="group bg-white/70 shadow-xl dark:bg-white/5 border border-gray-100 dark:border-white/10 dark:shadow-none backdrop-blur-md p-6 rounded-xl transition-all duration-300 hover:shadow-2xl hover:-translate-y-1">
        <h3 class="text-xl font-semibold mb-2 text-gray-900 dark:text-white flex items-center">
          Crypto
          <span class="inline-block w-2 h-2 rounded-full bg-[#EBC05E] group-hover:animate-ping ml-2"></span>
        </h3>
        <p class="text-gray-600 dark:text-gray-400">Deep dives into blockchain technology and Web3.</p>
      </div>
      <div class="group bg-white/70 shadow-xl dark:bg-white/5 border border-gray-100 dark:border-white/10 dark:shadow-none backdrop-blur-md p-6 rounded-xl transition-all duration-300 hover:shadow-2xl hover:-translate-y-1">
        <h3 class="text-xl font-semibold mb-2 text-gray-900 dark:text-white flex items-center">
          Fintech
          <span class="inline-block w-2 h-2 rounded-full bg-[#EBC05E] group-hover:animate-ping ml-2"></span>
        </h3>
        <p class="text-gray-600 dark:text-gray-400">Clear communication for financial innovations.</p>
      </div>
      <div class="group bg-white/70 shadow-xl dark:bg-white/5 border border-gray-100 dark:border-white/10 dark:shadow-none backdrop-blur-md p-6 rounded-xl transition-all duration-300 hover:shadow-2xl hover:-translate-y-1">
        <h3 class="text-xl font-semibold mb-2 text-gray-900 dark:text-white flex items-center">
          Gaming
          <span class="inline-block w-2 h-2 rounded-full bg-[#EBC05E] group-hover:animate-ping ml-2"></span>
        </h3>
        <p class="text-gray-600 dark:text-gray-400">Engaging narratives for the gaming industry.</p>
      </div>
    </div>
  </div>
</section>
