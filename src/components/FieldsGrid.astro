---
// FieldsGrid.astro
const fields = [
  { name: "Crypto", desc: "Deep dives into blockchain technology and Web3." },
  { name: "Fintech", desc: "Clear communication for financial innovations." },
  { name: "Gaming", desc: "Engaging narratives for the gaming industry." },
  { name: "Web3", desc: "DeFi, NFTs, and decentralized protocols." },
  { name: "AI", desc: "Demystifying artificial intelligence concepts." },
];
---

<section class="py-16 overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    <div class="mb-8 px-4 md:px-0">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-gold"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
        Industry Experience
      </h2>
    </div>
    
    <div class="relative w-auto flex overflow-hidden [mask-image:_linear-gradient(to_right,transparent_0,_black_30px,_black_calc(100%-30px),transparent_100%)] md:[mask-image:_linear-gradient(to_right,transparent_0,_black_80px,_black_calc(100%-80px),transparent_100%)] -mx-4 md:-mx-[15%] px-4 md:px-[15%]">
      <div id="fields-marquee" class="flex animate-marquee whitespace-nowrap min-w-max gap-8 py-4 pr-8">
        {[...fields, ...fields].map((field) => (
          <div class="group w-80 bg-white/70 shadow-xl dark:bg-white/5 border border-gray-100 dark:border-white/10 dark:shadow-none backdrop-blur-md p-6 rounded-xl transition-all duration-300 hover:shadow-2xl hover:-translate-y-1 whitespace-normal">
            <h3 class="text-xl font-semibold mb-2 text-gray-900 dark:text-white flex items-center">
              {field.name}
              <span class="inline-block w-2 h-2 rounded-full bg-[#EBC05E] group-hover:animate-ping ml-2"></span>
            </h3>
            <p class="text-gray-600 dark:text-gray-400">{field.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  {
    const marquee = document.getElementById('fields-marquee');
    if (marquee) {
      let timeoutId: number | undefined;
      const pauseHandler = () => {
        marquee.style.animationPlayState = 'paused';
        clearTimeout(timeoutId);
        timeoutId = window.setTimeout(() => {
          marquee.style.animationPlayState = '';
        }, 4000);
      };
      
      marquee.addEventListener('mouseenter', pauseHandler, { passive: true });
      marquee.addEventListener('touchstart', pauseHandler, { passive: true });
      marquee.addEventListener('wheel', pauseHandler, { passive: true });
    }
  }
</script>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    animation: marquee 25s linear infinite;
  }
</style>
