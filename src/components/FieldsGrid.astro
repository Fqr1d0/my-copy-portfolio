---
// FieldsGrid.astro
---

<section class="py-16">
  <div class="max-w-7xl mx-auto px-4">
    <h2 class="text-3xl font-bold mb-8 text-center bg-clip-text text-transparent bg-gradient-to-r from-primary to-indigo-400">Industry Expertise</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-white p-6 rounded-xl shadow border border-gray-100 hover:shadow-lg transition">
        <h3 class="text-xl font-semibold mb-2">Crypto</h3>
        <p class="text-gray-600">Deep dives into blockchain technology and Web3.</p>
      </div>
      <div class="bg-white p-6 rounded-xl shadow border border-gray-100 hover:shadow-lg transition">
        <h3 class="text-xl font-semibold mb-2">Fintech</h3>
        <p class="text-gray-600">Clear communication for financial innovations.</p>
      </div>
      <div class="bg-white p-6 rounded-xl shadow border border-gray-100 hover:shadow-lg transition">
        <h3 class="text-xl font-semibold mb-2">Gaming</h3>
        <p class="text-gray-600">Engaging narratives for the gaming industry.</p>
      </div>
    </div>
  </div>
</section>
