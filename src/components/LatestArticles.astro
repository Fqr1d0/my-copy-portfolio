---
// LatestArticles.astro
const articles = [
  {
    title: "The Evolution of Web3 Narratives in 2025",
    simplifiedTitle: "Future-Proof Your Crypto Brand",
    readTime: "5 min read",
    field: "Web3",
    type: "Trend Analysis",
    link: "/blog/web3-narratives",
    image: "https://images.unsplash.com/photo-1639762681485-074b7f4tcG52?auto=format&fit=crop&q=80&w=800&h=400"
  },
  {
    title: "How AI is Reshaping Fintech Copywriting",
    simplifiedTitle: "Smart Writing for Smart Money",
    readTime: "7 min read",
    field: "Fintech",
    type: "Industry Insight",
    link: "/blog/ai-fintech",
    image: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&q=80&w=800&h=400"
  },
  {
    title: "Building Trust Through Technical Writing",
    simplifiedTitle: "Clear Docs = Happy Devs",
    readTime: "4 min read",
    field: "Tech",
    type: "Best Practices",
    link: "/blog/technical-writing-trust",
    image: "https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&q=80&w=800&h=400"
  },
  {
    title: "Level Up Your Game Narrative Design",
    simplifiedTitle: "Storytelling That Players Love",
    readTime: "6 min read",
    field: "Gaming",
    type: "Guide",
    link: "/blog/game-narrative",
    image: "https://images.unsplash.com/photo-1552820728-8b83bb6b773f?auto=format&fit=crop&q=80&w=800&h=400"
  },
  {
    title: "Crypto Compliance & Content Strategy",
    simplifiedTitle: "Write Safe, Sell Hard",
    readTime: "5 min read",
    field: "Crypto",
    type: "Strategy",
    link: "/blog/crypto-compliance",
    image: "https://images.unsplash.com/photo-1621416894569-0f39ed31d247?auto=format&fit=crop&q=80&w=800&h=400"
  },
  {
    title: "Generative AI in Modern SaaS Marketing",
    simplifiedTitle: "AI Tools for Better Copy",
    readTime: "8 min read",
    field: "AI",
    type: "Deep Dive",
    link: "/blog/gen-ai-saas",
    image: "https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&q=80&w=800&h=400"
  }
];
---

<section class="py-16 overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex justify-between items-end mb-8">
      <h2 class="text-3xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-primary to-indigo-400 dark:from-indigo-400 dark:to-primary">Latest Articles</h2>
      <a href="/blog" class="text-primary dark:text-indigo-400 hover:underline font-medium">View all</a>
    </div>
    
    <div class="relative w-auto flex overflow-hidden [mask-image:_linear-gradient(to_right,transparent_0,_black_30px,_black_calc(100%-30px),transparent_100%)] md:[mask-image:_linear-gradient(to_right,transparent_0,_black_80px,_black_calc(100%-80px),transparent_100%)] -mx-4 md:-mx-[15%] px-4 md:px-[15%]">
      <div id="articles-marquee" class="flex animate-marquee whitespace-nowrap min-w-max gap-8 py-4 pr-8">
        {[...articles, ...articles].map((article) => (
          <a href={article.link} class="w-[320px] md:w-[380px] shrink-0 group block relative bg-white/70 dark:bg-white/5 border border-gray-100 dark:border-white/10 shadow-xl dark:shadow-none backdrop-blur-md rounded-2xl overflow-hidden transition-all duration-300 hover:shadow-2xl hover:scale-105 whitespace-normal">
            <!-- Image container with gold overlay on hover -->
            <div class="relative h-48 w-full overflow-hidden bg-gray-200 dark:bg-gray-800">
              <img src={article.image} alt={article.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-tr from-indigo-500/40 to-purple-500/40 dark:from-indigo-500/30 dark:to-purple-500/30 mix-blend-multiply dark:mix-blend-overlay"></div>
              <div class="absolute inset-0 bg-brand-gold opacity-0 group-hover:opacity-20 transition-opacity duration-300 z-10"></div>
              <!-- Article Type Badge -->
              <div class="absolute top-4 left-4 z-20">
                <span class="inline-block px-2.5 py-1 bg-white/90 dark:bg-black/80 backdrop-blur-sm text-gray-800 dark:text-gray-200 text-xs font-semibold rounded-md shadow-sm border border-gray-200 dark:border-white/10">
                  {article.type}
                </span>
              </div>
            </div>
            
            <div class="p-6 relative bg-white dark:bg-transparent">
              <div class="flex justify-between items-start mb-4">
                <span class="inline-block px-3 py-1 bg-indigo-50 dark:bg-indigo-500/20 text-primary dark:text-indigo-300 text-xs font-bold rounded-full uppercase tracking-wider">
                  {article.field}
                </span>
                <span class="text-sm text-gray-500 dark:text-gray-400 flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  {article.readTime}
                </span>
              </div>
              
              <div class="relative h-16 w-full overflow-hidden">
                <!-- Technical Title -->
                <h3 class="absolute inset-0 text-xl font-medium text-brand-dark dark:text-white mb-2 leading-tight transition-all duration-500 opacity-100 translate-y-0 group-hover:opacity-0 group-hover:-translate-y-4">
                  {article.title}
                </h3>
                <!-- Simplified Title -->
                <h3 class="absolute inset-0 text-xl font-medium text-brand-gold mb-2 leading-tight transition-all duration-500 opacity-0 translate-y-4 group-hover:opacity-100 group-hover:translate-y-0">
                  {article.simplifiedTitle}
                </h3>
              </div>
              
              <div class="absolute bottom-6 right-6 text-gray-400 group-hover:text-brand-gold transform -rotate-45 group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  {
    const marquee = document.getElementById('articles-marquee');
    if (marquee) {
      let timeoutId: number | undefined;
      const pauseHandler = () => {
        marquee.style.animationPlayState = 'paused';
        clearTimeout(timeoutId);
        timeoutId = window.setTimeout(() => {
          marquee.style.animationPlayState = '';
        }, 5000);
      };
      
      marquee.addEventListener('mouseenter', pauseHandler, { passive: true });
      marquee.addEventListener('touchstart', pauseHandler, { passive: true });
      marquee.addEventListener('wheel', pauseHandler, { passive: true });
    }
  }
</script>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    animation: marquee 35s linear infinite;
  }
</style>
