---
// Navbar.astro
const pathname = Astro.url.pathname;
const links = [
  { name: 'Works', href: '/works' },
  { name: 'Fields', href: '/fields' },
  { name: 'Blog', href: '/blog' },
  { name: 'Contact', href: '/contact' },
];
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-white/80 border-b border-gray-100/80 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    
    <!-- Logo -->
    <a href="/" class="group relative flex items-center gap-2 z-50">
      <div class="w-2.5 h-2.5 bg-primary rounded-full group-hover:scale-[1.35] transition-transform duration-300 ease-out shadow-[0_0_10px_rgba(79,70,229,0.4)]"></div>
      <span class="font-extrabold text-2xl tracking-tight text-gray-900 transition-colors">
        Copy<span class="text-gray-400 font-medium">page</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex flex-row items-center space-x-2">
      {links.map((link) => {
        const isActive = pathname.startsWith(link.href) && link.href !== '/' || pathname === link.href;
        return (
          <a
            href={link.href}
            class={`relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-300 ${
              isActive 
                ? 'text-primary bg-indigo-50/60' 
                : 'text-gray-500 hover:text-gray-900 hover:bg-gray-100/80'
            }`}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <!-- Right Side Actions & Mobile Menu Toggle -->
    <div class="flex items-center gap-3 z-50">
      <a href="/contact" class="hidden md:inline-flex items-center justify-center px-5 py-2 text-sm font-semibold text-white transition-all duration-300 bg-gray-900 rounded-full hover:bg-primary shadow-sm hover:shadow-primary/30">
        Hire Me
      </a>
      <button id="mobile-menu-btn" class="md:hidden p-2 text-gray-500 hover:text-gray-900 focus:outline-none transition-colors">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="icon-menu">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
