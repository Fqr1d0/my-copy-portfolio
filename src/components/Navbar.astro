---
// Navbar.astro
const pathname = Astro.url.pathname;
const links = [
  { name: 'Works', href: '/works' },
  { name: 'Fields', href: '/fields' },
  { name: 'Blog', href: '/blog' },
  { name: 'Contact', href: '/contact' },
];
---

<header class="sticky top-6 z-50 w-[calc(100%-3rem)] max-w-6xl mx-auto rounded-full backdrop-blur-xl bg-white/80 dark:bg-dark-bg/80 border border-gray-100/80 dark:border-white/10 transition-colors duration-500 shadow-sm">
  <div class="px-6 h-16 flex items-center justify-between">
    
    <!-- Logo -->
    <a href="/" class="group relative flex items-center gap-2 z-50">
      <div class="w-2.5 h-2.5 bg-brand-gold rounded-full group-hover:scale-[1.35] transition-transform duration-300 ease-out shadow-[0_0_10px_rgba(235,192,94,0.4)]"></div>
      <span class="font-bold tracking-tighter text-2xl text-gray-900 dark:text-white transition-colors duration-500">
        FaridADOI
      </span>
    </a>

    <!-- Desktop Navigation Capsule -->
    <nav class="hidden md:flex flex-row items-center space-x-2 rounded-full px-8 py-2">
      {links.map((link) => {
        const isActive = pathname.startsWith(link.href) && link.href !== '/' || pathname === link.href;
        return (
          <a
            href={link.href}
            class={`relative bg-white/20 dark:bg-white/5  px-4 py-2 text-sm font-semibold rounded-full transition-all duration-300 ${
              isActive 
                ? 'text-brand-gold bg-brand-gold/10' 
                : 'text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100/80 dark:hover:bg-white/10'
            }`}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <!-- Right Side Actions -->
    <div class="flex items-center gap-3 z-50">
      <a href="/contact" class="hidden md:inline-flex items-center justify-center px-5 py-2.5 text-sm font-bold text-gray-900 transition-all duration-300 bg-brand-gold rounded-full hover:scale-105 shadow-sm hover:shadow-brand-gold/30">
        Hire Me
      </a>
      <button id="theme-toggle" class="p-2 rounded-full border border-gray-200 dark:border-white/10 text-gray-500 dark:text-gray-400 hover:scale-110 transition-transform duration-300 bg-white/50 dark:bg-white/5" aria-label="Toggle Dark Mode">
        <span class="block dark:hidden">🌙</span>
        <span class="hidden dark:block">☀️</span>
      </button>
      <button id="mobile-menu-btn" class="md:hidden p-2 text-gray-500 hover:text-gray-900 dark:hover:text-white focus:outline-none transition-colors">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="icon-menu">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const handleToggleClick = () => {
    const element = document.documentElement;
    element.classList.toggle("dark");

    const isDark = element.classList.contains("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  }

  document.getElementById("theme-toggle")?.addEventListener("click", handleToggleClick);
</script>
