---
import BaseLayout from '../../layouts/BaseLayout.astro';
const fields = await Astro.glob('../../content/fields/*.md');
---

<BaseLayout title="Fields - Copypage">
  <div class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-8">Professional Fields</h1>
    <ul class="space-y-4">
      {fields.map((field) => (
        <li class="bg-white p-6 shadow rounded-lg border">
          <a href={`/fields/${field.file.split('/').pop().replace('.md', '')}`} class="text-2xl font-semibold text-primary hover:underline">
            {field.frontmatter.title || 'Untitled Field'}
          </a>
          <p class="mt-2 text-gray-600">{field.frontmatter.description}</p>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
