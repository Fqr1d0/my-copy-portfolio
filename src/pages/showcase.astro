---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Showcase & Portfolio - Copypage">
  <div class="max-w-7xl mx-auto py-16 md:py-24">
    
    {/* Page Header */}
    <div class="text-center max-w-3xl mx-auto mb-16 px-4">
      <div class="inline-block px-3 py-1 bg-brand-gold/10 border border-brand-gold/30 text-brand-gold text-xs font-bold rounded-full uppercase tracking-wider mb-6">
        Curated Archive
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6 tracking-tight">Portfolio Works</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">
        A gallery of my best works. Swipe through my specialized archives below to see how I translate complex ideas into compelling copy.
      </p>
    </div>

    {/* TOPIC 1: Web3 & Blockchain */}
    <div class="mb-20">
      <div class="flex items-center justify-between mb-6 px-4 md:px-8 max-w-7xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-gold"><polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"></polygon><line x1="12" y1="22" x2="12" y2="15.5"></line><polyline points="22 8.5 12 15.5 2 8.5"></polyline><polyline points="2 15.5 12 8.5 22 15.5"></polyline><line x1="12" y1="2" x2="12" y2="8.5"></line></svg>
          Web3 & Blockchain
        </h2>
        <div class="hidden md:flex gap-2">
          <button onclick="scrollArchive('archive-web3', -400)" class="w-10 h-10 rounded-full border border-gray-200 dark:border-gray-700 flex items-center justify-center text-gray-500 hover:bg-brand-gold hover:text-white dark:hover:bg-brand-gold hover:border-brand-gold transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <button onclick="scrollArchive('archive-web3', 400)" class="w-10 h-10 rounded-full border border-gray-200 dark:border-gray-700 flex items-center justify-center text-gray-500 hover:bg-brand-gold hover:text-white dark:hover:bg-brand-gold hover:border-brand-gold transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
      </div>

      {/* Horizontal Scrolling Container */}
      <div id="archive-web3" class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar gap-6 pb-8 px-4 md:px-8 scroll-smooth">
        
        {/* Card 1 */}
        <div class="snap-start shrink-0 w-[300px] md:w-[400px] flex flex-col bg-white dark:bg-gray-900 rounded-2xl border border-gray-100 dark:border-white/10 shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group overflow-hidden h-full">
          <div class="h-48 bg-gray-100 dark:bg-gray-800 w-full relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-brand-gold/20 to-purple-500/20 mix-blend-overlay z-10 group-hover:scale-110 transition-transform duration-700"></div>
            <div class="absolute top-4 left-4 z-20">
              <span class="bg-white/90 dark:bg-gray-900/90 backdrop-blur-sm text-gray-900 dark:text-white text-xs font-bold px-3 py-1 rounded-full shadow-sm">Whitepaper</span>
            </div>
          </div>
          <div class="p-6 flex-grow flex flex-col">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3 group-hover:text-brand-gold transition-colors">DeFi Protocol Economics</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm mb-6 flex-grow">A comprehensive 40-page whitepaper breaking down the tokenomics, staking mechanisms, and liquidity pools of a next-gen DeFi protocol.</p>
            <div class="flex items-center gap-3 mt-auto">
              <a href="#" class="flex-1 text-center bg-gray-50 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-900 dark:text-white text-sm font-semibold py-2.5 rounded-lg transition-colors border border-gray-200 dark:border-gray-700">Read PDF</a>
              <button data-open-modal data-service="Whitepapers" class="flex-1 text-center bg-brand-gold/10 hover:bg-brand-gold text-brand-gold hover:text-white dark:hover:text-gray-900 text-sm font-semibold py-2.5 rounded-lg transition-colors border border-brand-gold/20 hover:border-brand-gold">Hire for Similar</button>
            </div>
          </div>
        </div>

        {/* Card 2 */}
        <div class="snap-start shrink-0 w-[300px] md:w-[400px] flex flex-col bg-white dark:bg-gray-900 rounded-2xl border border-gray-100 dark:border-white/10 shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group overflow-hidden h-full">
          <div class="h-48 bg-gray-100 dark:bg-gray-800 w-full relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-tr from-brand-gold/20 to-blue-500/20 mix-blend-overlay z-10 group-hover:scale-110 transition-transform duration-700"></div>
            <div class="absolute top-4 left-4 z-20">
              <span class="bg-white/90 dark:bg-gray-900/90 backdrop-blur-sm text-gray-900 dark:text-white text-xs font-bold px-3 py-1 rounded-full shadow-sm">Blog Post</span>
            </div>
          </div>
          <div class="p-6 flex-grow flex flex-col">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3 group-hover:text-brand-gold transition-colors">The Future of Layer 2s</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm mb-6 flex-grow">An SEO-optimized deep dive explaining ZK-Rollups to a mainstream audience, generating 10k+ organic views in month one.</p>
            <div class="flex items-center gap-3 mt-auto">
              <a href="#" class="flex-1 text-center bg-gray-50 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-900 dark:text-white text-sm font-semibold py-2.5 rounded-lg transition-colors border border-gray-200 dark:border-gray-700">Read Post</a>
              <button data-open-modal data-service="Blog Posts" class="flex-1 text-center bg-brand-gold/10 hover:bg-brand-gold text-brand-gold hover:text-white dark:hover:text-gray-900 text-sm font-semibold py-2.5 rounded-lg transition-colors border border-brand-gold/20 hover:border-brand-gold">Hire for Similar</button>
            </div>
          </div>
        </div>

        {/* Card 3 */}
        <div class="snap-start shrink-0 w-[300px] md:w-[400px] flex flex-col bg-white dark:bg-gray-900 rounded-2xl border border-gray-100 dark:border-white/10 shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group overflow-hidden h-full">
          <div class="h-48 bg-gray-100 dark:bg-gray-800 w-full relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-r from-brand-gold/20 to-teal-500/20 mix-blend-overlay z-10 group-hover:scale-110 transition-transform duration-700"></div>
            <div class="absolute top-4 left-4 z-20">
              <span class="bg-white/90 dark:bg-gray-900/90 backdrop-blur-sm text-gray-900 dark:text-white text-xs font-bold px-3 py-1 rounded-full shadow-sm">Website Copy</span>
            </div>
          </div>
          <div class="p-6 flex-grow flex flex-col">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3 group-hover:text-brand-gold transition-colors">NFT Marketplace Landing</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm mb-6 flex-grow">High-converting homepage copy for a multi-chain NFT marketplace. Increased beta signups by 45% through targeted value propositions.</p>
            <div class="flex items-center gap-3 mt-auto">
              <a href="#" class="flex-1 text-center bg-gray-50 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-900 dark:text-white text-sm font-semibold py-2.5 rounded-lg transition-colors border border-gray-200 dark:border-gray-700">View Site</a>
              <button data-open-modal data-service="Website Copy" class="flex-1 text-center bg-brand-gold/10 hover:bg-brand-gold text-brand-gold hover:text-white dark:hover:text-gray-900 text-sm font-semibold py-2.5 rounded-lg transition-colors border border-brand-gold/20 hover:border-brand-gold">Hire for Similar</button>
            </div>
          </div>
        </div>

        {/* View All Card */}
        <div class="snap-start shrink-0 w-[200px] flex flex-col justify-center items-center bg-gray-50 dark:bg-gray-800/50 rounded-2xl border border-gray-100 dark:border-gray-800 shadow-sm hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors duration-300 h-full min-h-[350px] cursor-pointer group">
           <div class="w-16 h-16 rounded-full bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 flex items-center justify-center mb-4 group-hover:border-brand-gold group-hover:text-brand-gold transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
           </div>
           <span class="font-bold text-gray-900 dark:text-white group-hover:text-brand-gold transition-colors">View All Web3</span>
        </div>

      </div>
    </div>

    {/* TOPIC 2: AI & Machine Learning */}
    <div class="mb-20">
      <div class="flex items-center justify-between mb-6 px-4 md:px-8 max-w-7xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-gold"><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          AI & Machine Learning
        </h2>
        <div class="hidden md:flex gap-2">
          <button onclick="scrollArchive('archive-ai', -400)" class="w-10 h-10 rounded-full border border-gray-200 dark:border-gray-700 flex items-center justify-center text-gray-500 hover:bg-brand-gold hover:text-white dark:hover:bg-brand-gold hover:border-brand-gold transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <button onclick="scrollArchive('archive-ai', 400)" class="w-10 h-10 rounded-full border border-gray-200 dark:border-gray-700 flex items-center justify-center text-gray-500 hover:bg-brand-gold hover:text-white dark:hover:bg-brand-gold hover:border-brand-gold transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
      </div>

      <div id="archive-ai" class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar gap-6 pb-8 px-4 md:px-8 scroll-smooth">
        
        {/* Card 1 */}
        <div class="snap-start shrink-0 w-[300px] md:w-[400px] flex flex-col bg-white dark:bg-gray-900 rounded-2xl border border-gray-100 dark:border-white/10 shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group overflow-hidden h-full">
          <div class="h-48 bg-gray-100 dark:bg-gray-800 w-full relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-brand-gold/20 to-emerald-500/20 mix-blend-overlay z-10 group-hover:scale-110 transition-transform duration-700"></div>
            <div class="absolute top-4 left-4 z-20">
              <span class="bg-white/90 dark:bg-gray-900/90 backdrop-blur-sm text-gray-900 dark:text-white text-xs font-bold px-3 py-1 rounded-full shadow-sm">Documentation</span>
            </div>
          </div>
          <div class="p-6 flex-grow flex flex-col">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3 group-hover:text-brand-gold transition-colors">LLM API Documentation</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm mb-6 flex-grow">Developer-centric API documentation for a new Large Language Model, reducing developer onboarding time by 30%.</p>
            <div class="flex items-center gap-3 mt-auto">
              <a href="#" class="flex-1 text-center bg-gray-50 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-900 dark:text-white text-sm font-semibold py-2.5 rounded-lg transition-colors border border-gray-200 dark:border-gray-700">View Docs</a>
              <button data-open-modal data-service="Project Documentation" class="flex-1 text-center bg-brand-gold/10 hover:bg-brand-gold text-brand-gold hover:text-white dark:hover:text-gray-900 text-sm font-semibold py-2.5 rounded-lg transition-colors border border-brand-gold/20 hover:border-brand-gold">Hire for Similar</button>
            </div>
          </div>
        </div>

        {/* Card 2 */}
        <div class="snap-start shrink-0 w-[300px] md:w-[400px] flex flex-col bg-white dark:bg-gray-900 rounded-2xl border border-gray-100 dark:border-white/10 shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group overflow-hidden h-full">
          <div class="h-48 bg-gray-100 dark:bg-gray-800 w-full relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-tr from-brand-gold/20 to-orange-500/20 mix-blend-overlay z-10 group-hover:scale-110 transition-transform duration-700"></div>
            <div class="absolute top-4 left-4 z-20">
              <span class="bg-white/90 dark:bg-gray-900/90 backdrop-blur-sm text-gray-900 dark:text-white text-xs font-bold px-3 py-1 rounded-full shadow-sm">Whitepaper</span>
            </div>
          </div>
          <div class="p-6 flex-grow flex flex-col">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3 group-hover:text-brand-gold transition-colors">Generative AI in Healthcare</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm mb-6 flex-grow">A B2B thought-leadership whitepaper aimed at hospital executives, explaining complex neural networks in accessible business terms.</p>
            <div class="flex items-center gap-3 mt-auto">
              <a href="#" class="flex-1 text-center bg-gray-50 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-900 dark:text-white text-sm font-semibold py-2.5 rounded-lg transition-colors border border-gray-200 dark:border-gray-700">Read PDF</a>
              <button data-open-modal data-service="Whitepapers" class="flex-1 text-center bg-brand-gold/10 hover:bg-brand-gold text-brand-gold hover:text-white dark:hover:text-gray-900 text-sm font-semibold py-2.5 rounded-lg transition-colors border border-brand-gold/20 hover:border-brand-gold">Hire for Similar</button>
            </div>
          </div>
        </div>

      </div>
    </div>
    
    {/* TOPIC 3: Fintech & Tech */}
    <div class="mb-10">
      <div class="flex items-center justify-between mb-6 px-4 md:px-8 max-w-7xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-gold"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
          Fintech & SaaS
        </h2>
        <div class="hidden md:flex gap-2">
          <button onclick="scrollArchive('archive-fin', -400)" class="w-10 h-10 rounded-full border border-gray-200 dark:border-gray-700 flex items-center justify-center text-gray-500 hover:bg-brand-gold hover:text-white dark:hover:bg-brand-gold hover:border-brand-gold transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <button onclick="scrollArchive('archive-fin', 400)" class="w-10 h-10 rounded-full border border-gray-200 dark:border-gray-700 flex items-center justify-center text-gray-500 hover:bg-brand-gold hover:text-white dark:hover:bg-brand-gold hover:border-brand-gold transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
      </div>

      <div id="archive-fin" class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar gap-6 pb-8 px-4 md:px-8 scroll-smooth">
        
        {/* Card 1 */}
        <div class="snap-start shrink-0 w-[300px] md:w-[400px] flex flex-col bg-white dark:bg-gray-900 rounded-2xl border border-gray-100 dark:border-white/10 shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group overflow-hidden h-full">
          <div class="h-48 bg-gray-100 dark:bg-gray-800 w-full relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-brand-gold/20 to-blue-800/20 mix-blend-overlay z-10 group-hover:scale-110 transition-transform duration-700"></div>
            <div class="absolute top-4 left-4 z-20">
              <span class="bg-white/90 dark:bg-gray-900/90 backdrop-blur-sm text-gray-900 dark:text-white text-xs font-bold px-3 py-1 rounded-full shadow-sm">Website Copy</span>
            </div>
          </div>
          <div class="p-6 flex-grow flex flex-col">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3 group-hover:text-brand-gold transition-colors">Neobank Onboarding App</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm mb-6 flex-grow">UX microcopy and landing page content for a digital bank, focusing on trust, security, and ease of use.</p>
            <div class="flex items-center gap-3 mt-auto">
              <a href="#" class="flex-1 text-center bg-gray-50 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-900 dark:text-white text-sm font-semibold py-2.5 rounded-lg transition-colors border border-gray-200 dark:border-gray-700">View Site</a>
              <button data-open-modal data-service="Website Copy" class="flex-1 text-center bg-brand-gold/10 hover:bg-brand-gold text-brand-gold hover:text-white dark:hover:text-gray-900 text-sm font-semibold py-2.5 rounded-lg transition-colors border border-brand-gold/20 hover:border-brand-gold">Hire for Similar</button>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .hide-scrollbar {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>

<script>
  // Simple scrolling function for the arrow buttons
  function scrollArchive(elementId, amount) {
    const container = document.getElementById(elementId);
    if (container) {
      container.scrollBy({ left: amount, behavior: 'smooth' });
    }
  }
  
  // Expose function to global scope for onclick handlers
  window.scrollArchive = scrollArchive;
</script>
