---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await Astro.glob('../../content/blog/*.md');
  return posts.map(post => ({
    params: { slug: post.file.split('/').pop().replace('.md', '') },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<BaseLayout title={post.frontmatter.title + " - Copypage"}>
  <article class="max-w-3xl mx-auto px-4 py-16 prose lg:prose-lg">
    <h1 class="text-4xl font-bold mb-4">{post.frontmatter.title}</h1>
    <div class="mt-8">
      <post.Content />
    </div>
  </article>
</BaseLayout>
