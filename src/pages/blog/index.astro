---
import BaseLayout from '../../layouts/BaseLayout.astro';
const posts = await Astro.glob('../../content/blog/*.md');
---

<BaseLayout title="Blog - Copypage">
  <div class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-8">Personal Vision Blog</h1>
    <ul class="space-y-4">
      {posts.map((post) => (
        <li class="bg-white p-6 shadow rounded-lg border">
          <a href={`/blog/${post.file.split('/').pop().replace('.md', '')}`} class="text-2xl font-semibold text-primary hover:underline">
            {post.frontmatter.title || 'Untitled Post'}
          </a>
          <p class="mt-2 text-gray-600">{post.frontmatter.description}</p>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
